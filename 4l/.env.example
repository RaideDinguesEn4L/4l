# Configuration environnement
# Copiez ce fichier en .env.local pour vos variables d'environnement

# Supabase — REQUIS pour le contenu éditable et la page /admin.
# Sans ces deux valeurs le site affiche son contenu de repli et /admin refuse
# de s'ouvrir. Elles sont lues AU BUILD (`next build` les inline) : après une
# modification, il faut reconstruire l'image Docker.
# La clé anon est publique par conception — l'écriture est refusée par la RLS
# Postgres à tout email absent de la table `l4_admins`.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.tomrambeau.fr
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Formulaire de contact (optionnel - pour intégration future)
# NEXT_PUBLIC_CONTACT_EMAIL=votre@email.com

# Analytics (optionnel)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Réseaux sociaux (déjà dans le code, mais peut être centralisé ici)
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/votre_compte
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/votre_page
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/votre_profil
